// The colour scheme GTK's widgets and `prefers-color-scheme` follow: set to
// dark or light, read back, and reset to the system's own. Needs a display.
import std.env;
import gtk {
    Application,
    lgtk_color_scheme,
    lgtk_css_provider_color_scheme,
    lgtk_css_provider_new_for_scheme,
    lgtk_css_provider_reduced_motion,
    lgtk_reduced_motion,
    lgtk_reset_color_scheme,
    lgtk_reset_reduced_motion,
    lgtk_set_color_scheme,
    lgtk_set_reduced_motion,
    run,
};

@test
fun the_color_scheme_is_set_and_read_back() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<i32[]> = Ref.new([]);
    run("org.lugha.test.settings", fun(a: Application) {
        let note = fun(n: i32) {
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(n);
                ys
            });
        };
        // GtkInterfaceColorScheme: 2 dark, 3 light; the system's own comes back on reset.
        let own = lgtk_color_scheme();
        lgtk_set_color_scheme(2);
        note(lgtk_color_scheme());
        lgtk_set_color_scheme(3);
        note(lgtk_color_scheme());
        lgtk_reset_color_scheme();
        note(if lgtk_color_scheme() == own { 0 } else { -1 });
        a.quit();
    });
    assert_eq(seen.get(), [2, 3, 0]);
}

@test
fun a_provider_for_the_scheme_follows_it() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<i32[]> = Ref.new([]);
    run("org.lugha.test.provider_scheme", fun(a: Application) {
        let note = fun(n: i32) {
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(n);
                ys
            });
        };
        // An app's own provider stays "default" unless it follows the setting.
        let provider = lgtk_css_provider_new_for_scheme();
        lgtk_set_color_scheme(2);
        note(lgtk_css_provider_color_scheme(provider));
        lgtk_set_color_scheme(3);
        note(lgtk_css_provider_color_scheme(provider));
        lgtk_reset_color_scheme();
        note(if lgtk_css_provider_color_scheme(provider) == lgtk_color_scheme() { 0 } else { -1 });
        a.quit();
    });
    assert_eq(seen.get(), [2, 3, 0]);
}

@test
fun reduced_motion_is_set_read_back_and_followed() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<i32[]> = Ref.new([]);
    run("org.lugha.test.reduced_motion", fun(a: Application) {
        let note = fun(n: i32) {
            seen.update(fun(xs) {
                let mut ys = xs;
                ys.push(n);
                ys
            });
        };
        // GtkReducedMotion: 0 no preference, 1 reduce.
        let own = lgtk_reduced_motion();
        let provider = lgtk_css_provider_new_for_scheme();
        lgtk_set_reduced_motion(1);
        note(lgtk_reduced_motion());
        note(lgtk_css_provider_reduced_motion(provider));
        lgtk_set_reduced_motion(0);
        note(lgtk_css_provider_reduced_motion(provider));
        lgtk_reset_reduced_motion();
        note(if lgtk_reduced_motion() == own { 0 } else { -1 });
        a.quit();
    });
    assert_eq(seen.get(), [1, 1, 0, 0]);
}
