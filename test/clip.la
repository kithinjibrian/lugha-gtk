// A clip: one child, asking for no minimum size, so it never pushes its
// parent; the child gets at least its own minimum, at the top start, and what
// sticks out is cut off and measured; `overflow-changed` fires from an idle
// once the overflow changes. Measured for a size the other way, it never
// measures its child for less than the child needs that way. Needs a display.
import std.env;
import gtk {
    Application,
    GtkWidget,
    connect_widget,
    g_log_set_always_fatal,
    gtk_application_window_new,
    gtk_box_append,
    gtk_box_new,
    gtk_box_remove,
    gtk_label_set_wrap,
    g_timeout_add_full,
    gtk_widget_allocate,
    gtk_widget_get_overflow,
    gtk_widget_measure,
    gtk_widget_set_size_request,
    gtk_window_set_child,
    lgtk_clip_get_child,
    lgtk_clip_new,
    lgtk_clip_overflow,
    lgtk_clip_set_child,
    gtk_label_new,
    run,
};

/** The widget's minimum and natural size one way (0 across, 1 down). */
fun measured(w: GtkWidget, orientation: i32): (i32, i32) = measured_for(w, orientation, -1);

/** The widget's minimum and natural size one way (0 across, 1 down), for `for_size` the other way. */
fun measured_for(w: GtkWidget, orientation: i32, for_size: i32): (i32, i32) {
    let mut minimum: i32 = 0;
    let mut natural: i32 = 0;
    let mut minimum_baseline: i32 = 0;
    let mut natural_baseline: i32 = 0;
    gtk_widget_measure(
        w,
        orientation,
        for_size,
        out minimum,
        out natural,
        out minimum_baseline,
        out natural_baseline,
    );
    (minimum, natural)
}

@test
fun a_clip_asks_for_nothing_and_measures_what_sticks_out() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let note = fun(s: string) {
        seen.update(fun(xs) {
            let mut ys = xs;
            ys.push(s);
            ys
        });
    };
    run("org.lugha.test.clip", fun(a: Application) {
        let window = gtk_application_window_new(a.handle());
        let clip = lgtk_clip_new();
        gtk_window_set_child(window, clip);
        let child = gtk_label_new("x");
        gtk_widget_set_size_request(child, 200, 100);
        lgtk_clip_set_child(clip, Some(child));
        note(
            "child kept {lgtk_clip_get_child(clip).is_some()} hidden overflow {gtk_widget_get_overflow(clip)}",
        );
        let (min_w, nat_w) = measured(clip, 0);
        let (min_h, nat_h) = measured(clip, 1);
        note("asks min {min_w}x{min_h} natural {nat_w}x{nat_h}");
        let changes = Ref.new(0);
        connect_widget(
            clip,
            "overflow-changed",
            fun(w: GtkWidget) {
                changes.update(fun(n) = n + 1);
            },
            0,
        );
        gtk_widget_allocate(clip, 120, 300, -1, None);
        note("120x300: across {lgtk_clip_overflow(clip, 1)} down {lgtk_clip_overflow(clip, 0)}");
        gtk_widget_allocate(clip, 50, 40, -1, None);
        note("50x40: across {lgtk_clip_overflow(clip, 1)} down {lgtk_clip_overflow(clip, 0)}");
        gtk_widget_allocate(clip, 300, 300, -1, None);
        note("300x300: across {lgtk_clip_overflow(clip, 1)} down {lgtk_clip_overflow(clip, 0)}");
        // The signal waits for an idle: none yet, inside this handler.
        note("signals so far {changes.get()}");
        // After GTK's loop has run: one signal for the three changes.
        g_timeout_add_full(0, 50, fun() {
            note("signals after the loop {changes.get()}");
            a.quit();
            0
        });
    });
    assert_eq(seen.get(), [
        "child kept true hidden overflow 1",
        "asks min 0x0 natural 200x100",
        "120x300: across 80 down 0",
        "50x40: across 150 down 60",
        "300x300: across 0 down 0",
        "signals so far 0",
        "signals after the loop 1",
    ]);
}

@test
fun a_clip_measures_its_child_for_no_less_than_its_minimum() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let note = fun(s: string) {
        seen.update(fun(xs) {
            let mut ys = xs;
            ys.push(s);
            ys
        });
    };
    run("org.lugha.test.clip_child_minimum", fun(a: Application) {
        let window = gtk_application_window_new(a.handle());
        let holder = gtk_box_new(1, 0);
        gtk_window_set_child(window, holder);
        // GTK warns when a widget is measured for less than its minimum the
        // other way ("Trying to measure … for width of 0, but it needs at
        // least 518"): from here such a warning aborts, failing the test.
        let old = g_log_set_always_fatal(16);
        // A child at least 518 x 264. GTK checks only widgets whose size
        // depends the other way: the wrapping label makes the box one.
        let child = gtk_box_new(0, 0);
        gtk_widget_set_size_request(child, 518, 264);
        let words = gtk_label_new("a b");
        gtk_label_set_wrap(words, 1);
        gtk_box_append(child, words);
        let clip = lgtk_clip_new();
        lgtk_clip_set_child(clip, Some(child));
        gtk_box_append(holder, clip);
        // For less than the child's minimum the other way: the clip still
        // asks for nothing, and would like the child's size at that minimum.
        note("height for width 0 {measured_for(clip, 1, 0)}");
        note("width for height 100 {measured_for(clip, 0, 100)}");
        // For more: as before.
        note("height for width 600 {measured_for(clip, 1, 600)}");
        g_log_set_always_fatal(old);
        gtk_box_remove(holder, clip);
        a.quit();
    });
    assert_eq(seen.get(), [
        "height for width 0 (0, 264)",
        "width for height 100 (0, 518)",
        "height for width 600 (0, 264)",
    ]);
}
