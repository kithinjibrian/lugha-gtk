/** `bytes` decoded, or what happened. */
fun decode(bytes: u8[]): (Option<GdkTexture>, string) {
    let block = g_bytes_new(bytes, bytes.len as u64);
    let mut error: Option<GError> = None;
    let texture = gdk_texture_new_from_bytes(block, out error);
    g_bytes_unref(block);
    let said = match error {
        Some(e) => {
            g_error_free(e);
            "error"
        }
        None => "ok",
    };
    (texture, said)
}

@test
fun bytes_decode_into_textures_shown_and_freed() {
    if env.get("DISPLAY").is_none() && env.get("WAYLAND_DISPLAY").is_none() {
        skip("no display");
    }
    let seen: Ref<string[]> = Ref.new([]);
    let note = fun(s: string) {
        seen.update(fun(xs) {
            let mut ys = xs;
            ys.push(s);
            ys
        });
    };
    run("org.lugha.test.textures", fun(a: Application) {
        for (name, bytes) of [("png", png()), ("jpeg", jpeg())] {
            let (texture, said) = decode(bytes);
            match texture {
                Some(t) => {
                    note("{name} {said} {gdk_texture_get_width(t)}x{gdk_texture_get_height(t)}");
                    gdk_texture_unref(t);
                }
                None => note("{name} {said} none"),
            }
        }
        let mut corrupt = png();
        corrupt[40] = 0;
        corrupt[41] = 0;
        let (bad, said) = decode(corrupt);
        note("corrupt {said} {bad.is_none()}");
        let empty: u8[] = [];
        let (nothing, said_empty) = decode(empty);
        note("empty {said_empty} {nothing.is_none()}");
        // Shown by a picture and an image, which keep their own references.
        let (shown, _) = decode(png());
        let Some(t) = shown else {
            panic("expected a texture");
        };
        on_texture_finalized(t, fun(gone: GdkTexture) {
            note("finalized");
        });
        let picture = gtk_picture_new();
        let image = gtk_image_new_from_icon_name("");
        gtk_picture_set_paintable(picture, Some(t));
        gtk_image_set_from_paintable(image, Some(t));
        gdk_texture_unref(t);
        note(
            "picture shows it: {gtk_picture_get_paintable(picture) == Some(t)} image: {gtk_image_get_paintable(image) == Some(t)}",
        );
        gtk_picture_set_paintable(picture, None);
        note("picture let go");
        gtk_image_set_from_paintable(image, None);
        note("image let go");
        a.quit();
    });
    assert_eq(seen.get(), [
        "png ok 3x2",
        "jpeg ok 3x2",
        "corrupt error true",
        "empty error true",
        "picture shows it: true image: true",
        "picture let go",
        "finalized",
        "image let go",
    ]);
}
