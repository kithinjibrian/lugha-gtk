// Images from bytes: a PNG and a JPEG decoded into textures and read back,
// corrupt bytes refused with an error that's freed, textures shown in a
// picture and an image, and a texture finalized once nothing holds it. Needs
// a display.
import std.env;
import gtk {
    Application,
    GError,
    GdkTexture,
    g_bytes_new,
    g_bytes_unref,
    g_error_free,
    gdk_texture_get_height,
    gdk_texture_get_width,
    gdk_texture_new_from_bytes,
    gdk_texture_unref,
    gtk_image_get_paintable,
    gtk_image_new_from_icon_name,
    gtk_image_set_from_paintable,
    gtk_picture_get_paintable,
    gtk_picture_new,
    gtk_picture_set_paintable,
    on_texture_finalized,
    run,
};

