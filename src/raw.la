/**
 * The C side of GTK 4 and GLib that this package wraps: typed handles and
 * externs, each matching GTK 4's headers. Everything is `public`, for what
 * the wrappers in `gtk.app` and `gtk.widgets` don't cover yet.
 */

/** A `PangoAttrList *`: text attributes (weight, size, …) for a label. */
public extern type PangoAttrList;

/** A `PangoAttribute *`, owned by the list it's inserted into. */
public extern type PangoAttribute;

/** A `GtkTextBuffer *`: the text a `GtkTextView` shows. */
public extern type GtkTextBuffer;

/** A `char *` C allocated for the caller: read it with `lgtk_cstring_text`, then `g_free` it. */
public extern type OwnedText;

/** A `GtkEventController *` (a `GtkShortcutController` here): input handling attached to a widget. */
public extern type GtkEventController;

/** A `GtkShortcut *`: a trigger and the action it runs. */
public extern type GtkShortcut;

/** A `GtkShortcutTrigger *`, such as a key combination. */
public extern type GtkShortcutTrigger;

/** A `GtkShortcutAction *`, such as activating a widget. */
public extern type GtkShortcutAction;

/** A `GVariant *`: arguments GTK may hand a shortcut's callback. */
public extern type GVariant;

/** A `GtkStringList *`: a list of strings, the model a drop-down shows. */
public extern type GtkStringList;

/** A `GtkExpression *` (drop-downs take `None` for plain string lists). */
public extern type GtkExpression;

/** A `GParamSpec *`: which property a `notify::…` signal is about. */
public extern type GParamSpec;

/** A `GtkApplication *`. */
public extern type GtkApplication;

/** Any `GtkWidget *`: windows, boxes, buttons, labels, entries. GTK's casts between them are the same pointer. */
public extern type GtkWidget;

/** A `char **` argument vector; `None` passes `NULL`. */
public extern type Argv;

public extern fun gtk_application_new(id: string, flags: i32): GtkApplication;
public extern fun g_application_run(app: GtkApplication, argc: i32, argv: Option<Argv>): i32;
public extern fun g_application_quit(app: GtkApplication);
/** Keeps the application running with no window open, until a matching `g_application_release`. */
public extern fun g_application_hold(app: GtkApplication);
public extern fun g_application_release(app: GtkApplication);
public extern fun g_object_unref(object: GtkApplication);

public extern fun gtk_application_window_new(app: GtkApplication): GtkWidget;
public extern fun gtk_window_set_title(window: GtkWidget, title: string);
public extern fun gtk_window_set_default_size(window: GtkWidget, width: i32, height: i32);
public extern fun gtk_window_set_child(window: GtkWidget, child: GtkWidget);
public extern fun gtk_window_present(window: GtkWidget);
public extern fun gtk_window_get_title(window: GtkWidget): Option<string>;

/** `orientation`: 0 horizontal, 1 vertical (`GtkOrientation`). */
public extern fun gtk_box_new(orientation: i32, spacing: i32): GtkWidget;
public extern fun gtk_box_append(box: GtkWidget, child: GtkWidget);
/** Pixels between a box's children. */
public extern fun gtk_box_set_spacing(box: GtkWidget, spacing: i32);
public extern fun gtk_box_get_spacing(box: GtkWidget): i32;
/** Takes `child` out of `box`. */
public extern fun gtk_box_remove(box: GtkWidget, child: GtkWidget);
/** Puts `child` into `box` right after `sibling`, or first when `sibling` is `None`. */
public extern fun gtk_box_insert_child_after(
    box: GtkWidget,
    child: GtkWidget,
    sibling: Option<GtkWidget>,
);
/** Moves `child`, already in `box`, to right after `sibling`, or first when `sibling` is `None`. */
public extern fun gtk_box_reorder_child_after(
    box: GtkWidget,
    child: GtkWidget,
    sibling: Option<GtkWidget>,
);

public extern fun gtk_button_new_with_label(label: string): GtkWidget;
public extern fun gtk_button_set_label(button: GtkWidget, label: string);
public extern fun gtk_button_get_label(button: GtkWidget): Option<string>;

public extern fun gtk_label_new(text: string): GtkWidget;
public extern fun gtk_label_set_text(label: GtkWidget, text: string);
public extern fun gtk_label_get_text(label: GtkWidget): string;

// Long text in a label. `gboolean` as `i32`; PangoWrapMode: 0 word, 1 char,
// 2 word else char; PangoEllipsizeMode: 0 none, 1 start, 2 middle, 3 end.
public extern fun gtk_label_set_wrap(label: GtkWidget, wrap: i32);
public extern fun gtk_label_get_wrap(label: GtkWidget): i32;
public extern fun gtk_label_set_wrap_mode(label: GtkWidget, mode: i32);
public extern fun gtk_label_get_wrap_mode(label: GtkWidget): i32;
public extern fun gtk_label_set_ellipsize(label: GtkWidget, mode: i32);
public extern fun gtk_label_get_ellipsize(label: GtkWidget): i32;
/** With wrapping and ellipsizing both on, the most lines shown; -1 for no limit. */
public extern fun gtk_label_set_lines(label: GtkWidget, lines: i32);
public extern fun gtk_label_get_lines(label: GtkWidget): i32;
/** The most characters of width the label asks for; -1 for no cap. */
public extern fun gtk_label_set_max_width_chars(label: GtkWidget, chars: i32);
public extern fun gtk_label_get_max_width_chars(label: GtkWidget): i32;
public extern fun gtk_label_set_selectable(label: GtkWidget, selectable: i32);
public extern fun gtk_label_get_selectable(label: GtkWidget): i32;
/** Sets (or, with `None`, clears) a label's text attributes; the label keeps its own reference. */
public extern fun gtk_label_set_attributes(label: GtkWidget, attrs: Option<PangoAttrList>);
public extern fun gtk_label_get_attributes(label: GtkWidget): Option<PangoAttrList>;

// Pango text attributes. Sizes are points times PANGO_SCALE (1024); weights
// are PangoWeight numbers (400 normal, 700 bold).
public extern fun pango_attr_list_new(): PangoAttrList;
public extern fun pango_attr_list_unref(list: PangoAttrList);
/** Adds `attr` to `list`, which takes ownership of it. */
public extern fun pango_attr_list_insert(list: PangoAttrList, attr: PangoAttribute);
/** The list as text, such as `0 4294967295 weight bold`; for tests and debugging (Lugha copies the string and never frees Pango's, a small leak per call). */
public extern fun pango_attr_list_to_string(list: PangoAttrList): string;
public extern fun pango_attr_weight_new(weight: i32): PangoAttribute;
public extern fun pango_attr_size_new(size: i32): PangoAttribute;

public extern fun gtk_entry_new(): GtkWidget;
/** Grey hint text shown while an entry is empty and unfocused; `None` removes it. */
public extern fun gtk_entry_set_placeholder_text(entry: GtkWidget, text: Option<string>);
/** The placeholder; after clearing it with `None`, GTK gives back an empty string. */
public extern fun gtk_entry_get_placeholder_text(entry: GtkWidget): Option<string>;
public extern fun gtk_editable_get_text(editable: GtkWidget): string;
public extern fun gtk_editable_set_text(editable: GtkWidget, text: string);
/** The cursor's position in characters (from 0). */
public extern fun gtk_editable_get_position(editable: GtkWidget): i32;
/** Puts the cursor at `position` characters; -1 is the end. */
public extern fun gtk_editable_set_position(editable: GtkWidget, position: i32);

// GtkCheckButton. Its booleans are C `gboolean`s (`int`): 0 is false.
public extern fun gtk_check_button_new_with_label(label: string): GtkWidget;
public extern fun gtk_check_button_new(): GtkWidget;
/** Shows `child` (such as a label of your own) beside the box instead of a plain label. */
public extern fun gtk_check_button_set_child(check: GtkWidget, child: Option<GtkWidget>);
public extern fun gtk_check_button_get_child(check: GtkWidget): Option<GtkWidget>;
public extern fun gtk_check_button_get_active(check: GtkWidget): i32;
public extern fun gtk_check_button_set_active(check: GtkWidget, active: i32);
public extern fun gtk_check_button_get_label(check: GtkWidget): Option<string>;
public extern fun gtk_check_button_set_label(check: GtkWidget, label: string);

public extern fun gtk_widget_set_margin_start(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_end(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_top(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_bottom(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_get_margin_start(widget: GtkWidget): i32;
public extern fun gtk_widget_get_margin_top(widget: GtkWidget): i32;

/** `GtkAlign`: 0 fill, 1 start, 2 end, 3 center. */
public extern fun gtk_widget_set_halign(widget: GtkWidget, align: i32);
public extern fun gtk_widget_get_halign(widget: GtkWidget): i32;
public extern fun gtk_widget_set_valign(widget: GtkWidget, align: i32);
public extern fun gtk_widget_get_valign(widget: GtkWidget): i32;

/** The smallest size `widget` may be given, in pixels; -1 leaves a side to the widget. */
public extern fun gtk_widget_set_size_request(widget: GtkWidget, width: i32, height: i32);

// CSS classes: how the theme styles a widget (`suggested-action`,
// `destructive-action`, `flat`, `dim-label`, …). `gboolean` as `i32`.
public extern fun gtk_widget_add_css_class(widget: GtkWidget, class: string);
public extern fun gtk_widget_remove_css_class(widget: GtkWidget, class: string);
public extern fun gtk_widget_has_css_class(widget: GtkWidget, class: string): i32;

/** Whether a widget responds to the user; an insensitive one is greyed out. `gboolean` as `i32`. */
public extern fun gtk_widget_set_sensitive(widget: GtkWidget, sensitive: i32);

/** Hover text; `None` removes it. */
public extern fun gtk_widget_set_tooltip_text(widget: GtkWidget, text: Option<string>);
public extern fun gtk_widget_get_tooltip_text(widget: GtkWidget): Option<string>;
public extern fun gtk_widget_get_sensitive(widget: GtkWidget): i32;

// Expanding: a widget given spare room along an axis (`gboolean` as `i32`).
public extern fun gtk_widget_set_hexpand(widget: GtkWidget, expand: i32);
public extern fun gtk_widget_get_hexpand(widget: GtkWidget): i32;
public extern fun gtk_widget_set_vexpand(widget: GtkWidget, expand: i32);
public extern fun gtk_widget_get_vexpand(widget: GtkWidget): i32;

// Walking a widget's children in the order GTK shows them; `None` past the end.
public extern fun gtk_widget_get_first_child(widget: GtkWidget): Option<GtkWidget>;
public extern fun gtk_widget_get_next_sibling(widget: GtkWidget): Option<GtkWidget>;

/** `GtkOrientation` of a box, separator or other orientable: 0 horizontal, 1 vertical. */
public extern fun gtk_orientable_get_orientation(orientable: GtkWidget): i32;

/** A line between widgets; `orientation` as for `gtk_box_new`. */
public extern fun gtk_separator_new(orientation: i32): GtkWidget;

// GtkScrolledWindow: one child, scrolled when it's bigger than the window.
public extern fun gtk_scrolled_window_new(): GtkWidget;
public extern fun gtk_scrolled_window_set_child(scrolled: GtkWidget, child: Option<GtkWidget>);
public extern fun gtk_scrolled_window_get_child(scrolled: GtkWidget): Option<GtkWidget>;

// `g_signal_connect_data` once per handler shape: GTK calls every signal
// handler with its object first and the user data last.

/**
 * Emits `signal` on `instance` as if the user had acted, for signals with no
 * arguments and no result such as `clicked` or `activate`. Handlers run before
 * it returns. (`src/c/signals.c` wraps the variadic `g_signal_emit_by_name`, which
 * Lugha can't declare.)
 */
public extern "lgtk_emit" fun emit_widget(instance: GtkWidget, signal: string);

/** Connects a handler taking the application, such as `activate`. */
public extern "g_signal_connect_data" fun connect_app(
    instance: GtkApplication,
    signal: string,
    handler: fun(GtkApplication, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;

/** Connects a handler taking the widget, such as `clicked`, `changed` and `activate`. */
public extern "g_signal_connect_data" fun connect_widget(
    instance: GtkWidget,
    signal: string,
    handler: fun(GtkWidget, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;

// GLib timers and clocks.

/**
 * Calls `function` every `interval` milliseconds on the main loop while it
 * returns 1 (G_SOURCE_CONTINUE); returning 0 (G_SOURCE_REMOVE) stops it.
 * `priority` is a GLib priority (0 is G_PRIORITY_DEFAULT).
 * @returns the source id, for `g_source_remove`.
 */
public extern fun g_timeout_add_full(
    priority: i32,
    interval: u32,
    function: fun(data): i32,
    user: data,
    notify: release,
): u32;

/** Stops the timer `tag`; 1 if it was running. */
public extern fun g_source_remove(tag: u32): i32;

/** Wall-clock time in microseconds since 1970. */
public extern fun g_get_real_time(): i64;

/** Microseconds from an arbitrary start that never jumps; for measuring intervals. */
public extern fun g_get_monotonic_time(): i64;

/**
 * Calls `notify` once `widget` is finalized: destroyed and its last reference
 * gone, its signal handlers released. The widget it's given is already gone:
 * don't use it. GLib takes no release function here, so the closure stays
 * pinned for the program's life; meant for tests and checks, not per widget.
 */
public extern "g_object_weak_ref" fun on_finalized(
    widget: GtkWidget,
    notify: fun(data, GtkWidget),
    user: data,
);

// GtkTextView, a multi-line editor, and its buffer. Iterator work happens in
// src/c/text.c (GtkTextIter is a struct passed by pointer).
public extern fun gtk_text_view_new(): GtkWidget;
public extern fun gtk_text_view_get_buffer(view: GtkWidget): GtkTextBuffer;
/** `GtkWrapMode`: 0 none, 1 char, 2 word, 3 word, else char. */
public extern fun gtk_text_view_set_wrap_mode(view: GtkWidget, mode: i32);
public extern fun gtk_text_view_get_wrap_mode(view: GtkWidget): i32;
/** Replaces the buffer's text; `length` -1 means all of `text`. */
public extern fun gtk_text_buffer_set_text(buffer: GtkTextBuffer, text: string, length: i32);
/** All of the buffer's text, allocated for the caller (src/c/text.c). */
public extern fun lgtk_text_get(buffer: GtkTextBuffer): OwnedText;
/** The text of an `OwnedText`, copied into a Lugha string; `g_free` it after. */
public extern fun lgtk_cstring_text(text: OwnedText): string;
/** The cursor's position in characters (src/c/text.c). */
public extern fun lgtk_text_cursor(buffer: GtkTextBuffer): i32;
/** Puts the cursor at `offset` characters, or at the end when the text is shorter (src/c/text.c). */
public extern fun lgtk_text_place_cursor(buffer: GtkTextBuffer, offset: i32);
/** Frees memory GLib or GTK allocated for the caller. */
public extern fun g_free(memory: OwnedText);

/** Connects a handler taking the buffer, such as a text buffer's `changed`. */
public extern "g_signal_connect_data" fun connect_buffer(
    instance: GtkTextBuffer,
    signal: string,
    handler: fun(GtkTextBuffer, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;

// Keyboard shortcuts (GtkShortcutController) and focus.

public extern fun gtk_shortcut_controller_new(): GtkEventController;
/** `GtkShortcutScope`: 0 local, 1 managed, 2 global (anywhere in the window). */
public extern fun gtk_shortcut_controller_set_scope(controller: GtkEventController, scope: i32);
/** Adds `shortcut`; the controller takes ownership of it. */
public extern fun gtk_shortcut_controller_add_shortcut(
    controller: GtkEventController,
    shortcut: GtkShortcut,
);
public extern fun gtk_shortcut_controller_remove_shortcut(
    controller: GtkEventController,
    shortcut: GtkShortcut,
);
/** Attaches `controller` to `widget`, which takes ownership of it. */
public extern fun gtk_widget_add_controller(widget: GtkWidget, controller: GtkEventController);
/** A shortcut running `action` on `trigger`; it takes ownership of both. */
public extern fun gtk_shortcut_new(
    trigger: GtkShortcutTrigger,
    action: GtkShortcutAction,
): GtkShortcut;
/**
 * An action calling `callback` with the widget the shortcut belongs to; it
 * returns 1 when it handled the key. Works on widgets not yet on screen,
 * unlike GTK's activate action. The closure is released with the action.
 */
public extern fun gtk_callback_action_new(
    callback: fun(GtkWidget, Option<GVariant>, data): i32,
    user: data,
    destroy: release,
): GtkShortcutAction;
/** GTK's accelerator syntax (`<Control>n`); `None` when it can't be parsed. */
public extern fun gtk_shortcut_trigger_parse_string(text: string): Option<GtkShortcutTrigger>;
/** The action that activates the widget the shortcut belongs to (GTK keeps it: don't free). */
public extern fun gtk_activate_action_get(): GtkShortcutAction;
/** A new reference to `action`, for handing it to something that takes ownership. */
public extern "g_object_ref" fun gtk_shortcut_action_ref(
    action: GtkShortcutAction,
): GtkShortcutAction;
/** Runs `action` on `widget` as a shortcut would (`flags` 0, no arguments); 1 if it did something. */
public extern fun gtk_shortcut_action_activate(
    action: GtkShortcutAction,
    flags: i32,
    widget: GtkWidget,
    args: Option<GVariant>,
): i32;

/** The shortcut's trigger (the shortcut keeps it: don't free). */
public extern fun gtk_shortcut_get_trigger(shortcut: GtkShortcut): GtkShortcutTrigger;
/** The shortcut's action (the shortcut keeps it: don't free). */
public extern fun gtk_shortcut_get_action(shortcut: GtkShortcut): GtkShortcutAction;
/** The trigger in GTK's syntax (`<Control>n`), allocated: read with `lgtk_cstring_text`, then `g_free`. */
public extern fun gtk_shortcut_trigger_to_string(trigger: GtkShortcutTrigger): OwnedText;

/** Gives `widget` keyboard focus; 1 if it took it. */
public extern fun gtk_widget_grab_focus(widget: GtkWidget): i32;
/** Whether `widget` is inside `ancestor` (a child, grandchild, …); `gboolean` as `i32`. */
public extern fun gtk_widget_is_ancestor(widget: GtkWidget, ancestor: GtkWidget): i32;

/** The widget with keyboard focus in `window`, if any; a text field's focus sits on a widget inside it. */
public extern fun gtk_root_get_focus(window: GtkWidget): Option<GtkWidget>;

// Drop-downs over a string list, and scales (sliders).

/** A new, empty string list (`None`: no initial strings). */
public extern fun gtk_string_list_new(strings: Option<Argv>): GtkStringList;
public extern fun gtk_string_list_append(list: GtkStringList, text: string);
/** Drops a reference to a string list you made and no longer keep. */
public extern "g_object_unref" fun gtk_string_list_unref(list: GtkStringList);
/** A drop-down showing `model`, which it takes ownership of; `expression` `None` for string lists. */
public extern fun gtk_drop_down_new(
    model: Option<GtkStringList>,
    expression: Option<GtkExpression>,
): GtkWidget;
/** Shows `model` instead (the drop-down takes its own reference). */
public extern fun gtk_drop_down_set_model(dropdown: GtkWidget, model: Option<GtkStringList>);
/** Picks item `position`. A drop-down with items always has one picked: 0xffffffff (none) is ignored. */
public extern fun gtk_drop_down_set_selected(dropdown: GtkWidget, position: u32);
public extern fun gtk_drop_down_get_selected(dropdown: GtkWidget): u32;
/** The list a drop-down shows (GTK's `GListModel *`: here, the string list it was given), `None` when it has none. */
public extern fun gtk_drop_down_get_model(dropdown: GtkWidget): Option<GtkStringList>;
/** How many strings the list holds (`g_list_model_get_n_items`). */
public extern "g_list_model_get_n_items" fun gtk_string_list_get_n_items(list: GtkStringList): u32;
/** The string at `position`, copied; `None` past the end. */
public extern fun gtk_string_list_get_string(list: GtkStringList, position: u32): Option<string>;

/** Connects a handler for a `notify::property` signal, which takes the object and the property's spec. */
public extern "g_signal_connect_data" fun connect_notify(
    instance: GtkWidget,
    signal: string,
    handler: fun(GtkWidget, Option<GParamSpec>, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;

/** A scale from `min` to `max` moving in `step`s; `orientation` 0 horizontal, 1 vertical. */
public extern fun gtk_scale_new_with_range(
    orientation: i32,
    min: f64,
    max: f64,
    step: f64,
): GtkWidget;
/** Decimals shown for the drawn value. */
public extern fun gtk_scale_set_digits(scale: GtkWidget, digits: i32);
/** Whether the current value is drawn beside the handle (`gboolean` as `i32`). */
public extern fun gtk_scale_set_draw_value(scale: GtkWidget, draw: i32);
public extern fun gtk_range_set_value(range: GtkWidget, value: f64);
public extern fun gtk_range_get_value(range: GtkWidget): f64;
public extern fun gtk_range_set_range(range: GtkWidget, min: f64, max: f64);
/** The step for arrow keys and the page for Page Up/Down. */
public extern fun gtk_range_set_increments(range: GtkWidget, step: f64, page: f64);
/** Rounds values to this many decimals as the user moves the handle (0: whole numbers). */
public extern fun gtk_range_set_round_digits(range: GtkWidget, digits: i32);
