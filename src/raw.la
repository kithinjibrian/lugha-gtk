/**
 * The C side of GTK 4 and GLib that this package wraps: typed handles and
 * externs, each matching GTK 4's headers. Everything is `public`, for what
 * the wrappers in `gtk.app` and `gtk.widgets` don't cover yet.
 */

/** A `PangoAttrList *`: text attributes (weight, size, …) for a label. */
public extern type PangoAttrList;

/** A `PangoAttribute *`, owned by the list it's inserted into. */
public extern type PangoAttribute;

/** A `GtkApplication *`. */
public extern type GtkApplication;

/** Any `GtkWidget *`: windows, boxes, buttons, labels, entries. GTK's casts between them are the same pointer. */
public extern type GtkWidget;

/** A `char **` argument vector; `None` passes `NULL`. */
public extern type Argv;

public extern fun gtk_application_new(id: string, flags: i32): GtkApplication;
public extern fun g_application_run(app: GtkApplication, argc: i32, argv: Option<Argv>): i32;
public extern fun g_application_quit(app: GtkApplication);
public extern fun g_object_unref(object: GtkApplication);

public extern fun gtk_application_window_new(app: GtkApplication): GtkWidget;
public extern fun gtk_window_set_title(window: GtkWidget, title: string);
public extern fun gtk_window_set_default_size(window: GtkWidget, width: i32, height: i32);
public extern fun gtk_window_set_child(window: GtkWidget, child: GtkWidget);
public extern fun gtk_window_present(window: GtkWidget);

/** `orientation`: 0 horizontal, 1 vertical (`GtkOrientation`). */
public extern fun gtk_box_new(orientation: i32, spacing: i32): GtkWidget;
public extern fun gtk_box_append(box: GtkWidget, child: GtkWidget);
/** Pixels between a box's children. */
public extern fun gtk_box_set_spacing(box: GtkWidget, spacing: i32);
public extern fun gtk_box_get_spacing(box: GtkWidget): i32;
/** Takes `child` out of `box`. */
public extern fun gtk_box_remove(box: GtkWidget, child: GtkWidget);
/** Puts `child` into `box` right after `sibling`, or first when `sibling` is `None`. */
public extern fun gtk_box_insert_child_after(
    box: GtkWidget,
    child: GtkWidget,
    sibling: Option<GtkWidget>,
);
/** Moves `child`, already in `box`, to right after `sibling`, or first when `sibling` is `None`. */
public extern fun gtk_box_reorder_child_after(
    box: GtkWidget,
    child: GtkWidget,
    sibling: Option<GtkWidget>,
);

public extern fun gtk_button_new_with_label(label: string): GtkWidget;
public extern fun gtk_button_set_label(button: GtkWidget, label: string);
public extern fun gtk_button_get_label(button: GtkWidget): Option<string>;

public extern fun gtk_label_new(text: string): GtkWidget;
public extern fun gtk_label_set_text(label: GtkWidget, text: string);
public extern fun gtk_label_get_text(label: GtkWidget): string;
/** Sets (or, with `None`, clears) a label's text attributes; the label keeps its own reference. */
public extern fun gtk_label_set_attributes(label: GtkWidget, attrs: Option<PangoAttrList>);
public extern fun gtk_label_get_attributes(label: GtkWidget): Option<PangoAttrList>;

// Pango text attributes. Sizes are points times PANGO_SCALE (1024); weights
// are PangoWeight numbers (400 normal, 700 bold).
public extern fun pango_attr_list_new(): PangoAttrList;
public extern fun pango_attr_list_unref(list: PangoAttrList);
/** Adds `attr` to `list`, which takes ownership of it. */
public extern fun pango_attr_list_insert(list: PangoAttrList, attr: PangoAttribute);
/** The list as text, such as `0 4294967295 weight bold`; for tests and debugging (Lugha copies the string and never frees Pango's, a small leak per call). */
public extern fun pango_attr_list_to_string(list: PangoAttrList): string;
public extern fun pango_attr_weight_new(weight: i32): PangoAttribute;
public extern fun pango_attr_size_new(size: i32): PangoAttribute;

public extern fun gtk_entry_new(): GtkWidget;
public extern fun gtk_editable_get_text(editable: GtkWidget): string;
public extern fun gtk_editable_set_text(editable: GtkWidget, text: string);

// GtkCheckButton. Its booleans are C `gboolean`s (`int`): 0 is false.
public extern fun gtk_check_button_new_with_label(label: string): GtkWidget;
public extern fun gtk_check_button_get_active(check: GtkWidget): i32;
public extern fun gtk_check_button_set_active(check: GtkWidget, active: i32);
public extern fun gtk_check_button_get_label(check: GtkWidget): Option<string>;
public extern fun gtk_check_button_set_label(check: GtkWidget, label: string);

public extern fun gtk_widget_set_margin_start(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_end(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_top(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_set_margin_bottom(widget: GtkWidget, margin: i32);
public extern fun gtk_widget_get_margin_start(widget: GtkWidget): i32;
public extern fun gtk_widget_get_margin_top(widget: GtkWidget): i32;

/** `GtkAlign`: 0 fill, 1 start, 2 end, 3 center. */
public extern fun gtk_widget_set_halign(widget: GtkWidget, align: i32);
public extern fun gtk_widget_get_halign(widget: GtkWidget): i32;
public extern fun gtk_widget_set_valign(widget: GtkWidget, align: i32);
public extern fun gtk_widget_get_valign(widget: GtkWidget): i32;

/** The smallest size `widget` may be given, in pixels; -1 leaves a side to the widget. */
public extern fun gtk_widget_set_size_request(widget: GtkWidget, width: i32, height: i32);

// CSS classes: how the theme styles a widget (`suggested-action`,
// `destructive-action`, `flat`, `dim-label`, …). `gboolean` as `i32`.
public extern fun gtk_widget_add_css_class(widget: GtkWidget, class: string);
public extern fun gtk_widget_remove_css_class(widget: GtkWidget, class: string);
public extern fun gtk_widget_has_css_class(widget: GtkWidget, class: string): i32;

/** Whether a widget responds to the user; an insensitive one is greyed out. `gboolean` as `i32`. */
public extern fun gtk_widget_set_sensitive(widget: GtkWidget, sensitive: i32);
public extern fun gtk_widget_get_sensitive(widget: GtkWidget): i32;

// Expanding: a widget given spare room along an axis (`gboolean` as `i32`).
public extern fun gtk_widget_set_hexpand(widget: GtkWidget, expand: i32);
public extern fun gtk_widget_get_hexpand(widget: GtkWidget): i32;
public extern fun gtk_widget_set_vexpand(widget: GtkWidget, expand: i32);
public extern fun gtk_widget_get_vexpand(widget: GtkWidget): i32;

// Walking a widget's children in the order GTK shows them; `None` past the end.
public extern fun gtk_widget_get_first_child(widget: GtkWidget): Option<GtkWidget>;
public extern fun gtk_widget_get_next_sibling(widget: GtkWidget): Option<GtkWidget>;

/** `GtkOrientation` of a box, separator or other orientable: 0 horizontal, 1 vertical. */
public extern fun gtk_orientable_get_orientation(orientable: GtkWidget): i32;

/** A line between widgets; `orientation` as for `gtk_box_new`. */
public extern fun gtk_separator_new(orientation: i32): GtkWidget;

// GtkScrolledWindow: one child, scrolled when it's bigger than the window.
public extern fun gtk_scrolled_window_new(): GtkWidget;
public extern fun gtk_scrolled_window_set_child(scrolled: GtkWidget, child: Option<GtkWidget>);
public extern fun gtk_scrolled_window_get_child(scrolled: GtkWidget): Option<GtkWidget>;

// `g_signal_connect_data` once per handler shape: GTK calls every signal
// handler with its object first and the user data last.

/**
 * Emits `signal` on `instance` as if the user had acted, for signals with no
 * arguments and no result such as `clicked` or `activate`. Handlers run before
 * it returns. (`src/c/signals.c` wraps the variadic `g_signal_emit_by_name`, which
 * Lugha can't declare.)
 */
public extern "lgtk_emit" fun emit_widget(instance: GtkWidget, signal: string);

/** Connects a handler taking the application, such as `activate`. */
public extern "g_signal_connect_data" fun connect_app(
    instance: GtkApplication,
    signal: string,
    handler: fun(GtkApplication, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;

/** Connects a handler taking the widget, such as `clicked`, `changed` and `activate`. */
public extern "g_signal_connect_data" fun connect_widget(
    instance: GtkWidget,
    signal: string,
    handler: fun(GtkWidget, data),
    user: data,
    destroy: release,
    flags: i32,
): u64;
