/**
 * GTK 4 for Lugha. `import gtk { run, Window, … };` gives the application loop
 * and the widgets, and every C function and handle type of `gtk.raw` by its own
 * name too: `import gtk { GtkWidget, gtk_box_new };`. New externs in raw.la
 * come along without a change here.
 */

public import app { Application, run };
public import widgets { Widget, Window, Box, Button, Label, Entry };
public import raw { * };
