/**
 * GTK 4 for Lugha. `import gtk;` (or `import gtk { run, Window, … };`) gives
 * the application loop and the widgets, and `gtk.raw` the C functions
 * underneath (re-exported here, so `import gtk;` reaches them too).
 */

public import app { Application, run };
public import widgets { Widget, Window, Box, Button, Label, Entry };
public import raw;
